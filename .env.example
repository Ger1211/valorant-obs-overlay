# Cuenta de Valorant a trackear (Riot ID y tag, sin el '#')
RIOT_ID="LaLisa Hushoban"
RIOT_TAG="KPOP"

# Puertos. Los dos escuchan en 127.0.0.1; el tunel publica SOLO PORT.
PORT=4001
ADMIN_PORT=4002

# Ingesta automatica: milisegundos entre ciclos (0 la desactiva)
AUTO_INGEST_MS=20000

# Origen publico autorizado a leer /api/overlay (ej. https://tuusuario.github.io).
# '*' deja el dato abierto: es de solo lectura y publico a proposito.
PUBLIC_ORIGIN=*

# Token obligatorio para POST /api/ingest en el listener de administracion.
# Generar uno aleatorio: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_TOKEN=""

# Donde se guardan las partidas (JSON)
DATA_PATH=./data/matches.json

# Opcional: binario curl con fingerprint de navegador (curl-impersonate en Linux)
# TRACKER_CURL_BIN=/opt/curl-impersonate/curl_chrome136
